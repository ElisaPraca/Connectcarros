# Copie para .env (local) ou configure na Vercel (Project Settings > Environment Variables).
# Todas com o mesmo valor do painel do banco do projeto.

# Usadas no navegador (build-time)
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_XXXXXXXX"
VITE_SUPABASE_PROJECT_ID="SEU-PROJETO"

# Usadas no servidor (SSR / server functions)
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_XXXXXXXX"
SUPABASE_PROJECT_ID="SEU-PROJETO"

# Opcional: apenas se você usar operações administrativas no servidor
# SUPABASE_SERVICE_ROLE_KEY="sb_secret_XXXXXXXX"
